  "assessment_input_mapping": {
    "average_family_size": {
      "source": "FSIZE",
      "input": "average_family_size",
      "unit": "persons averaged over reference period",
      "note": "Verify FIES family membership/reference-period definition before integration; not current household headcount."
    },
    "food_per_person": {
      "source": "FOOD / FSIZE",
      "input": "annual_food_expenditure / average_family_size",
      "unit": "2025 PHP/person/year"
    },
    "nonfood_per_person": {
      "source": "(TOTEX - FOOD) / FSIZE",
      "input": "(annual_family_expenditure - annual_food_expenditure) / average_family_size",
      "unit": "2025 PHP/person/year"
    },
    "urban_area": {
      "source": "URBAN: 1 urban, 2 rural",
      "input": "verified urban/rural classification of residence",
      "unit": "1 urban, 0 rural",
      "note": "New assessment field required; do not infer from household income."
    },
    "food_share": {
      "source": "FOOD / TOTEX",
      "input": "annual_food_expenditure / annual_family_expenditure",
      "unit": "fraction 0 to 1"
    },
    "housing_utilities_per_person": {
      "source": "HOUSING_WATER / FSIZE",
      "input": "annual housing, water, electricity, gas and other fuel expenditure / average_family_size",
      "unit": "2025 PHP/person/year",
      "note": "New field; match FIES scope, including applicable housing rental value, before integration."
    },
    "health_per_person": {
      "source": "HEALTH / FSIZE",
      "input": "annual health expenditure / average_family_size",
      "unit": "2025 PHP/person/year",
      "note": "New field; zero expenditure does not prove absence of health needs."
    },
    "education_per_person": {
      "source": "EDUCATION / FSIZE",
      "input": "annual education expenditure / average_family_size",
      "unit": "2025 PHP/person/year",
      "note": "New field; zero expenditure does not prove absence of education needs."
    },
    "transport_per_person": {
      "source": "TRANSPORT / FSIZE",
      "input": "annual transport expenditure / average_family_size",
      "unit": "2025 PHP/person/year",
      "note": "New field; follow FIES expenditure definitions."
    }
  },
